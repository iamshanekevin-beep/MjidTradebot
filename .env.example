# Copy this file to .env for local testing.
# On Base44/Railway, set these under your project's Secrets/Variables instead —
# never commit a real .env with actual credentials to any repo.

IQ_EMAIL=you@example.com
IQ_PASSWORD=your_password
ACCOUNT_TYPE=PRACTICE

PAIR=EURUSD-OTC
TIMEFRAME_SECONDS=60
CANDLE_COUNT=100
EXPIRATION_MINUTES=1

STRATEGY=BOTH
FCB_FRACTAL_PERIOD=2

EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_UP=55
RSI_DOWN=45
CCI_PERIOD=14
CCI_UP=100
CCI_DOWN=-100
BB_PERIOD=20
BB_STD=2.0
POLE_POSITION_SCORE_THRESHOLD=3

TRADE_AMOUNT=1.0
MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=3
DAILY_LOSS_LIMIT=20.0

AUTO_TRADE=false
POLL_SECONDS=5
