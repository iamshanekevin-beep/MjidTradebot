# Base44 loads this file automatically via docker-compose's env_file directive.
# These are the DEFAULT values used unless overridden by Base44 secrets/env vars.
#
# SAFETY: AUTO_TRADE and TRADE_AMOUNT are explicitly set here to the safest
# possible values. Do not remove these two lines or change their values
# unless you have personally checked what you're setting and why. A
# previous deployment had TRADE_AMOUNT silently set to 100 with no one
# consciously choosing that value — this file exists so that can't happen
# by accident again.

AUTO_TRADE=false
TRADE_AMOUNT=1

ACCOUNT_TYPE=PRACTICE
PAIR=EURUSD-OTC
TIMEFRAME_SECONDS=60
CANDLE_COUNT=100
EXPIRATION_MINUTES=1

STRATEGY=BOTH
FCB_FRACTAL_PERIOD=2

EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_UP=55
RSI_DOWN=45
CCI_PERIOD=14
CCI_UP=100
CCI_DOWN=-100
BB_PERIOD=20
BB_STD=2.0
POLE_POSITION_SCORE_THRESHOLD=3

MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=3
DAILY_LOSS_LIMIT=20.0

POLL_SECONDS=5
